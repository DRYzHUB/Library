				local dragging = false

				local function SetSlider(newValue)
					value = math.clamp(math.floor(newValue + 0.5), minimum, maximum)

					local percentage = (value - minimum) / (maximum - minimum)

					Tween(fill, 0.1, {
						Size = UDim2.new(percentage, 0, 1, 0),
					})

					Tween(knob, 0.1, {
						Position = UDim2.new(percentage, 0, 0.5, 0),
					})

					valueLabel.Text = tostring(value) .. suffix

					if sliderConfig.Callback then
						task.spawn(sliderConfig.Callback, value)
					end
				end

				local function UpdateFromInput(input)
					local position = math.clamp(
						(input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
						0,
						1
					)

					SetSlider(minimum + ((maximum - minimum) * position))
				end

				bar.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						UpdateFromInput(input)
					end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
						or input.UserInputType == Enum.UserInputType.Touch) then
						UpdateFromInput(input)
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch then
						dragging = false
					end
				end)

				return {
					Set = SetSlider,
					Get = function()
						return value
					end,
				}
			end

			function section:AddDropdown(dropdownConfig)
				dropdownConfig = dropdownConfig or {}

				local options = dropdownConfig.Options or {}
				local selected = dropdownConfig.Default or options[1] or "Nenhuma opção"
				local opened = false

				local container = Create("Frame", {
					Size = UDim2.new(1, 0, 0, 52),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ClipsDescendants = true,
					Parent = holder,
				})

				local card = Create("Frame", {
					Size = UDim2.new(1, 0, 0, 52),
					BackgroundColor3 = Theme.Card,
					BorderSizePixel = 0,
					Parent = container,
				})

				Corner(card, 10)
				Stroke(card, Theme.Border, 1, 0.45)

				Create("TextLabel", {
					Position = UDim2.new(0, 14, 0, 8),
					Size = UDim2.new(1, -160, 0, 17),
					BackgroundTransparency = 1,
					Text = dropdownConfig.Name or "Dropdown",
					TextColor3 = Theme.Text,
					TextSize = 12,
					Font = Enum.Font.GothamMedium,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = card,
				})

				local selector = Create("TextButton", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -12, 0.5, 0),
					Size = UDim2.new(0, 135, 0, 30),
					BackgroundColor3 = Color3.fromRGB(39, 39, 51),
					BorderSizePixel = 0,
					Text = selected .. "  ▾",
					TextColor3 = Theme.Text,
					TextSize = 10,
					Font = Enum.Font.GothamMedium,
					Parent = card,
				})

				Corner(selector, 7)

				local list = Create("Frame", {
					Position = UDim2.new(0, 0, 0, 58),
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundColor3 = Theme.Card,
					BorderSizePixel = 0,
					Visible = false,
					Parent = container,
				})

				Corner(list, 10)
				Stroke(list, Theme.Border, 1, 0.45)
				Padding(list, 6, 6, 6, 6)

				Create("UIListLayout", {
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
					Parent = list,
				})

				local function Select(option)
					selected = option
					selector.Text = selected .. "  ▾"
					opened = false
					list.Visible = false

					if dropdownConfig.Callback then
						task.spawn(dropdownConfig.Callback, selected)
					end
				end

				for _, option in ipairs(options) do
					local optionButton = Create("TextButton", {
						Size = UDim2.new(1, 0, 0, 29),
						BackgroundColor3 = Color3.fromRGB(39, 39, 51),
						BorderSizePixel = 0,
						Text = option,
						TextColor3 = Theme.Muted,
						TextSize = 10,
						Font = Enum.Font.Gotham,
						Parent = list,
					})

					Corner(optionButton, 6)

					optionButton.MouseButton1Click:Connect(function()
						Select(option)
					end)
				end

				selector.MouseButton1Click:Connect(function()
					opened = not opened
					list.Visible = opened
				end)

				return {
					Set = Select,
					Get = function()
						return selected
					end,
				}
			end

			return section
		end

		table.insert(library.Tabs, tab)

		if #library.Tabs == 1 then
			tab:Select()
		end

		return tab
	end

	function library:Toggle()
		main.Visible = not main.Visible
	end

	function library:Destroy()
		screenGui:Destroy()
	end

	return library
end

return RedzLib
